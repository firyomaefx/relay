# /etc/relay/relay.env  (chmod 600, owner relay). Names only; fill on the server.
RELAY_DATA_DIR=
RELAY_HOST=
RELAY_PORT=
RELAY_CONSOLE_URL=
RELAY_PUBLIC_MEDIA_BASE_URL=
RELAY_CONSOLE_PASSWORD=
RELAY_BLOCKED_LINKS=
RELAY_BLOCKED_LINKS_UNTIL=
RELAY_BLOCKED_LINKS_PLATFORMS=
RELAY_MCP_HTTP_TOKEN=
RELAY_NO_BROWSER=
RELAY_MOCK=
THREADS_AUTOREPLY_ENABLED=
X_CLIENT_ID=
X_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_BASE=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
DEEPSEEK_API_KEY=

# Optional on VM: refuse deploy from wrong git remote (e.g. RELAY_DEPLOY_EXPECT_ORIGIN=ttrg/relay)
RELAY_DEPLOY_EXPECT_ORIGIN=
# Set automatically by deploy/deploy.sh to the commit being deployed (shown on /api/health as gitSha)
RELAY_GIT_SHA=
# Deploy script: DEPLOY_STRICT_SLEEP_VERIFY=1 enforces local sleep checks; set DEPLOY_STRICT_PUBLIC_SLEEP_VERIFY=1 after cloudflared → 4321

# --- Relay Cloud (multi-tenant) ---
RELAY_CLOUD_ENABLED=1
RELAY_CLOUD_TOKEN_KEY=
RELAY_CLOUD_DB=
RELAY_CLOUD_DATA_DIR=
RELAY_CLOUD_PRICES=/opt/relay/config/cloud-prices.json
RELAY_CLOUD_MCP_PORT=4321
RELAY_CLOUD_PUBLIC_URL=https://cloud-mcp.duitpoket.fun
RELAY_PUBLIC_URL=https://relay.duitpoket.fun
RELAY_PUBLIC_BASE_URL=https://relay.duitpoket.fun

# Sleep mode: customer schedulers without open console (console + cloud MCP)
RELAY_CLOUD_TENANT_SCHEDULER_MS=60000

# Onboarding, billing, operator alerts
RELAY_WAITLIST_AUTO_APPROVE=1
RELAY_WAITLIST_LIMIT=100
RELAY_EMAIL_PROVIDER=brevo
RELAY_BREVO_API_KEY=
RELAY_EMAIL_FROM=
RELAY_OPERATOR_ALERT_EMAIL=
# console | cloud-mcp | both (default both; set cloud-mcp if only cloud MCP runs 24/7)
RELAY_OPERATOR_NOTIFY_LEADER=cloud-mcp
RELAY_LOW_BALANCE_MILLI_USD=1000
RELAY_REVENUE_GOAL_MYR=4000
RELAY_REVENUE_GOAL_SINCE=2026-01-01T00:00:00.000Z
RELAY_REVENUE_GOAL_DEADLINE=2026-12-31
RELAY_THREADS_AUTOREPLY_AUTO_ENABLE=1
RELAY_ONBOARDING_TOPUP_NUDGE=1
RELAY_BREVO_WEBHOOK_ENSURE=1
RELAY_BREVO_WEBHOOK_ENSURE_COOLDOWN_MS=86400000
RELAY_OPERATOR_REVENUE_DIGEST=1

# Stripe / Polar (customer top-up)
RELAY_STRIPE_SECRET_KEY=
RELAY_STRIPE_WEBHOOK_SECRET=