# ---------------------------------------------------------------------------
# Relay configuration. Copy to .env in the repo root; Relay loads it automatically. Explicitly exported environment variables always win.
# these variables in your shell. Everything runs in simulated (mock) mode until
# you add credentials for a platform.
# ---------------------------------------------------------------------------

# Console
RELAY_DATA_DIR=./.data
RELAY_HOST=127.0.0.1
RELAY_PORT=4317
RELAY_CONSOLE_URL=http://127.0.0.1:4317

# Optional password for the local console. Leave empty for passwordless access
# on localhost. Set it if you expose the console beyond 127.0.0.1.
RELAY_CONSOLE_PASSWORD=

# Optional link guard: refuse posts (immediate and queued) whose text contains any of
# these comma-separated fragments, e.g. affiliate shop links during a reputation phase.
# RELAY_BLOCKED_LINKS=s.shopee.com.my,shope.ee
# RELAY_BLOCKED_LINKS_UNTIL=2026-12-01T00:00:00+08:00
# RELAY_BLOCKED_LINKS_PLATFORMS=threads,instagram,tiktok,youtube

# Force every platform into simulated mode (no real API calls, ever).
# RELAY_MOCK=1

# Public base URL that serves uploaded media from .data/media. Required for
# live media posts on Threads, and for TikTok photo posts, because both APIs
# fetch images from a public URL. Point this at a tunnel (ngrok, cloudflared)
# that forwards to the console port.
# RELAY_PUBLIC_MEDIA_BASE_URL=

# X / Twitter - https://developer.x.com (OAuth 2.0, public/native client)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Threads - https://developers.facebook.com (app with the Threads API product)
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
# Ask for the threads_delete permission at sign-in so relay_delete can remove Threads posts.
# Enable it on the Meta app first, then reconnect Threads.
# THREADS_REQUEST_DELETE_SCOPE=1

# Local Threads auto-reply. On by default: each published (or newly discovered)
# Threads post opens a 30-minute window, comments are classified and genuine
# ones get a short DeepSeek-written reply. Requires the threads_read_replies and
# threads_manage_replies scopes. Set to false to disable the feature entirely.
THREADS_AUTOREPLY_ENABLED=true

# DeepSeek (OpenAI-compatible chat completions). Needed only for auto-reply.
# Without this key the relay logs and skips comments; it never posts a fallback.
DEEPSEEK_API_KEY=

# YouTube - Google Cloud OAuth desktop/web client with YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram - Meta app with Instagram Graph API / content publishing
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# LinkedIn - app with Sign In with LinkedIn and Share on LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# TikTok - https://developers.tiktok.com (app with Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Relay Cloud payments (Polar sandbox/local trial)
# RELAY_POLAR_ACCESS_TOKEN=polar_oat_...
# RELAY_POLAR_PRODUCT_ID=
# RELAY_POLAR_WEBHOOK_SECRET=whsec_...
# RELAY_POLAR_API_BASE=https://sandbox-api.polar.sh
# RELAY_POLAR_SUCCESS_URL=https://relay.duitpoket.fun/billing/success
# RELAY_POLAR_CANCEL_URL=https://relay.duitpoket.fun/billing/cancel


