# ---------------------------------------------------------------------------
# Relay configuration. Copy to .env in the repo root; Relay loads it automatically. Explicitly exported environment variables always win.
# these variables in your shell. Everything runs in simulated (mock) mode until
# you add credentials for a platform.
# ---------------------------------------------------------------------------

# Console
RELAY_DATA_DIR=./.data
RELAY_HOST=127.0.0.1
RELAY_PORT=4317
RELAY_CONSOLE_URL=http://127.0.0.1:4317

# Optional password for the local console. Leave empty for passwordless access
# on localhost. Set it if you expose the console beyond 127.0.0.1.
RELAY_CONSOLE_PASSWORD=

# Optional link guard: refuse posts (immediate and queued) whose text contains any of
# these comma-separated fragments, e.g. affiliate shop links during a reputation phase.
# RELAY_BLOCKED_LINKS=s.shopee.com.my,shope.ee
# RELAY_BLOCKED_LINKS_UNTIL=2026-12-01T00:00:00+08:00
# RELAY_BLOCKED_LINKS_PLATFORMS=threads,instagram,tiktok,youtube

# Force every platform into simulated mode (no real API calls, ever).
# RELAY_MOCK=1

# Public base URL that serves uploaded media from .data/media. Required for
# live media posts on Threads, and for TikTok photo posts, because both APIs
# fetch images from a public URL. Point this at a tunnel (ngrok, cloudflared)
# that forwards to the console port.
# RELAY_PUBLIC_MEDIA_BASE_URL=

# X / Twitter - https://developer.x.com (OAuth 2.0, public/native client)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Threads - https://developers.facebook.com (app with the Threads API product)
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
# Ask for the threads_delete permission at sign-in so relay_delete can remove Threads posts.
# Enable it on the Meta app first, then reconnect Threads.
# THREADS_REQUEST_DELETE_SCOPE=1

# Local Threads auto-reply. On by default: each published (or newly discovered)
# Threads post opens a 30-minute window, comments are classified and genuine
# ones get a short DeepSeek-written reply. Requires the threads_read_replies and
# threads_manage_replies scopes. Set to false to disable the feature entirely.
THREADS_AUTOREPLY_ENABLED=true

# DeepSeek (OpenAI-compatible chat completions). Needed only for auto-reply.
# Without this key the relay logs and skips comments; it never posts a fallback.
DEEPSEEK_API_KEY=

# YouTube - Google Cloud OAuth desktop/web client with YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram - Meta app with Instagram Graph API / content publishing
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Facebook Pages - Facebook Login for Business plus pages_show_list,
# pages_read_engagement and pages_manage_posts. Keep the flag off until Meta
# review is complete and a real Page has been tested. When the same Meta app is
# used, the Facebook keys may be left empty and the Instagram app keys are used.
# RELAY_ENABLE_FACEBOOK=1
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# LinkedIn - app with Sign In with LinkedIn and Share on LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# TikTok - https://developers.tiktok.com (app with Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Relay Cloud payments (Polar sandbox/local trial)
# RELAY_POLAR_ACCESS_TOKEN=polar_oat_...
# RELAY_POLAR_PRODUCT_ID=
# RELAY_POLAR_WEBHOOK_SECRET=whsec_...
# RELAY_POLAR_API_BASE=https://sandbox-api.polar.sh
# RELAY_POLAR_SUCCESS_URL=https://relay.duitpoket.fun/billing/success
# RELAY_POLAR_CANCEL_URL=https://relay.duitpoket.fun/billing/cancel



# Relay Cloud waitlist and transactional email
RELAY_WAITLIST_LIMIT=100
# Auto-invite founding-batch signups (setup email + customer row); default off:
# RELAY_WAITLIST_AUTO_APPROVE=1
# Optional outbound webhook when a new (non-duplicate) waitlist entry is created.
# POST JSON: event waitlist.created, waitlist_id, created_at, pending_total (no PII).
# RELAY_WAITLIST_WEBHOOK_URL=https://hooks.example.com/relay-waitlist
# RELAY_WAITLIST_WEBHOOK_KEY=
# RELAY_WAITLIST_WEBHOOK_KEY_HEADER=Authorization
# Platform transactional mail: resend (default) or brevo.
# RELAY_EMAIL_PROVIDER=resend
# RELAY_EMAIL_FROM=Relay <hello@relay.duitpoket.fun>
# RELAY_EMAIL_REPLY_TO=support@relay.duitpoket.fun
# Resend (when RELAY_EMAIL_PROVIDER=resend or unset):
# RELAY_RESEND_API_KEY=re_...
# RELAY_RESEND_API_BASE=https://api.resend.com
# Brevo (when RELAY_EMAIL_PROVIDER=brevo):
# RELAY_BREVO_API_KEY=xkeysib-...
# RELAY_BREVO_API_BASE=https://api.brevo.com
# Email program inbound webhook (console Email tab):
# RELAY_PUBLIC_BASE_URL=https://relay.duitpoket.fun
# RELAY_BREVO_INBOUND_DOMAIN=reply.yourdomain.com
# RELAY_EMAIL_AUTOMATION_ENABLED=true
# Cloud sleep mode: poll customer schedulers (queue, email automation, Threads) without console login (ms; 0 disables):
# RELAY_CLOUD_TENANT_SCHEDULER_MS=60000
# Operator revenue goal (GET /api/cloud/admin/revenue-summary):
# RELAY_REVENUE_GOAL_MYR=4000
# RELAY_REVENUE_GOAL_DEADLINE=2026-12-31
# RELAY_REVENUE_GOAL_SINCE=2026-01-01T00:00:00.000Z
# Low-balance nudge email (milliUSD; 1000 = $1) and cooldown (default 7d):
# RELAY_LOW_BALANCE_MILLI_USD=1000
# RELAY_LOW_BALANCE_EMAIL_COOLDOWN_MS=604800000
# RELAY_TOPUP_RECEIPT_EMAIL=true
# Email new customers without a paid top-up after N days (default 3, cooldown 14 days):
# RELAY_ONBOARDING_TOPUP_NUDGE=1
# RELAY_ONBOARDING_TOPUP_NUDGE_DAYS=3
# RELAY_ONBOARDING_TOPUP_NUDGE_COOLDOWN_DAYS=14
# Operator digest when automation-health finds issues (default daily cooldown):
# Auto-enable Threads auto-reply when top-up + DeepSeek + Threads are ready (default on; set 0 to require manual enable):
# RELAY_THREADS_AUTOREPLY_AUTO_ENABLE=1
# RELAY_OPERATOR_ALERT_EMAIL=you@example.com
# RELAY_OPERATOR_ALERT_COOLDOWN_MS=86400000
# RELAY_OPERATOR_REVENUE_DIGEST=1
# RELAY_OPERATOR_REVENUE_DIGEST_COOLDOWN_MS=604800000
